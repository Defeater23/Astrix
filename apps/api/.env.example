# Module 8A server-side AI configuration. Copy to `.env` (never commit real values).
# These variables are read ONLY by apps/api. None starts with VITE_, so they never reach the browser.
# NEVER put private keys, seed phrases or real API keys in this file or in any committed file.

# "mock" (default): deterministic scripted adapter, no network, no key. Output is labelled as mock.
# "anthropic": real LLM calls through the Anthropic Messages HTTP API.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=anthropic. Placeholder values only.
AI_API_KEY=
AI_MODEL=

# Optional. Default https://api.anthropic.com. Must be https (http allowed for localhost only).
AI_API_BASE_URL=

# Optional limits (defaults shown).
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_REQUEST_CHARS=1000
# Seconds a proposal stays valid: 60 to 604800 (7 days).
AI_PROPOSAL_TTL_SECONDS=3600
