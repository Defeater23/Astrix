# Copy to `.env.local` (never commit real values). Only VITE_-prefixed variables reach the browser,
# so NEVER put private keys, seed phrases or API secrets in this file.

# Display name used in the UI.
VITE_APP_NAME=Sentinel Wallet

# Default chain the app expects. 11155111 = Ethereum Sepolia. 31337 = local Anvil.
VITE_DEFAULT_CHAIN_ID=11155111

# Block explorer base URL for the default chain (used from Module 09 onward).
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# Backend HTTP API base URL (used from Module 04 onward; unused in Module 01).
VITE_API_BASE_URL=http://localhost:4000

# Smart-account address per chain (public data; never put keys here). Leave empty until the
# account exists. Checksum casing is enforced if the address is mixed-case.
# See docs/SMART_ACCOUNT.md. Module 3 reads this address; it does not derive or deploy it.
VITE_SMART_ACCOUNT_ADDRESS_SEPOLIA=
VITE_SMART_ACCOUNT_ADDRESS_ANVIL=
