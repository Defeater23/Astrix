{
  "name": "sentinel-wallet",
  "private": true,
  "version": "0.1.0",
  "description": "Sentinel Wallet (Agent Wallet): letting AI agents pay safely. Root scripts delegate to workspaces.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "install:web": "npm --prefix apps/web install",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "typecheck": "npm --prefix apps/web run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "format:check": "npm --prefix apps/web run format:check",
    "test": "npm --prefix apps/web run test",
    "check": "npm --prefix apps/web run check",
    "install:api": "npm --prefix apps/api install",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "test:api": "npm --prefix apps/api run test",
    "check:api": "npm --prefix apps/api run check"
  }
}
